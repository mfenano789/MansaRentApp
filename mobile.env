# Réglages de l'appli Android / iPhone (lus par « npm run build:mobile »).
#
# Adresse du backend vue depuis le téléphone.
# Vide = l'adresse Wi-Fi de ce PC est détectée automatiquement (http://192.168.x.x:4000/api) ;
# le téléphone doit être sur le même Wi-Fi.
# En production : MOBILE_API_URL=https://api.mansarent.com/api
MOBILE_API_URL=

# Notifications push : mettez 1 seulement après avoir ajouté
# android/app/google-services.json (Firebase) — sinon l'appli Android plante.
VITE_PUSH_ENABLED=0

{
  "name": "mansarent-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MansaRent — Guinea's digital property rental marketplace (frontend)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:mobile": "vite build --mode mobile",
    "android": "vite build --mode mobile && npx cap sync android && npx cap run android",
    "android:open": "vite build --mode mobile && npx cap sync android && npx cap open android",
    "ios": "vite build --mode mobile && npx cap sync ios && npx cap open ios",
    "assets": "npx @capacitor/assets generate --iconBackgroundColor \"#0b5a3a\" --splashBackgroundColor \"#0b5a3a\" --splashBackgroundColorDark \"#0b5a3a\""
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/app": "^7.1.2",
    "@capacitor/cli": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/ios": "^7.6.9",
    "@capacitor/keyboard": "^7.0.6",
    "@capacitor/push-notifications": "^7.0.7",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "i18next": "^23.11.5",
    "i18next-browser-languagedetector": "^8.0.0",
    "lucide-react": "^0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^14.1.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.1",
    "vite-plugin-pwa": "^0.21.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}

# ============================================================
#  MansaRent — Frontend
#  Toutes ces variables sont OPTIONNELLES.
#  Laissées vides = l'application tourne en MODE DÉMO autonome
#  (aucun backend requis : connexion, chat, avis, abonnement et
#  paiement sont simulés en mémoire). Renseignez-les quand votre
#  API sera prête pour basculer automatiquement en mode réel.
# ============================================================

# Adresse de votre API backend.
# VIDE = mode démo (pas d'appels réseau). Ex. réel : http://localhost:4000/api
VITE_API_URL=

# Connexion Google (Sign in with Google).
# VIDE = bouton Google en mode démo. Sinon, collez votre OAuth Client ID Web
# (https://console.cloud.google.com → APIs & Services → Identifiants).
VITE_GOOGLE_CLIENT_ID=

# Paiement : fournisseur par défaut du guichet d'abonnement (utilisé en mode réel).
# cinetpay | hub2 | orange | mtnmomo  (cinetpay/hub2 couvrent OM + MTN + carte)
VITE_PAYMENT_PROVIDER=cinetpay
